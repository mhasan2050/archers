        <mxCell id="note" value="Historical Stage 1 + Stage 2A snapshot. Automatic folder indexing was added later; see README for current runtime. Docker runtime is not certified." style="text;html=0;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1500" height="45" as="geometry"/></mxCell>
