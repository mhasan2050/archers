  <diagram id="components" name="2 - Implemented Component Flow">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1150">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="COMPONENT FLOW | MANUAL INGESTION ACCEPTANCE" style="text;html=0;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1650" height="55" as="geometry"/></mxCell>
        <mxCell id="note" value="Acceptance is not parsing, indexing or publication. A 202 response means immutable bytes and a durable document/version/job linkage committed." style="text;html=0;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1700" height="45" as="geometry"/></mxCell>
        <mxCell id="request" value="CURATOR / ADMIN CLIENT&#xa;Multipart file + title&#xa;Cookie, Origin, CSRF, idempotency key&#xa;Replacement also requires If-Match" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="50" y="200" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="perimeter" value="API SECURITY BOUNDARY&#xa;Trusted Host / Origin&#xa;Current session + tenant + ingestion role&#xa;Session-bound CSRF before multipart" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="480" y="200" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="snapshot" value="SNAPSHOT SERVICE&#xa;Bound file/request bytes and fields&#xa;Allowed extension + byte signatures&#xa;Hash, fsync and immutable finalization" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="920" y="200" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="files" value="PRIVATE ORIGINALS&#xa;Generated IDs only&#xa;No user path execution" style="shape=cylinder3;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1400" y="200" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="commit" value="ACCEPTANCE TRANSACTION&#xa;Recheck auth; tenant serialization&#xa;Idempotent replay / conflict checks&#xa;Queue capacity + replacement revision" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="920" y="480" width="350" height="140" as="geometry"/></mxCell>
        <mxCell id="db" value="POSTGRESQL&#xa;Document PENDING / version RECEIVED&#xa;Job PENDING; audit + idempotency&#xa;Previous active pointer preserved" style="shape=cylinder3;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1400" y="480" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="response" value="202 ACCEPTED&#xa;document_id + version_id + job_id&#xa;Replay returns existing IDs&#xa;No ACTIVE/READY or completion claim" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="50" y="480" width="350" height="140" as="geometry"/></mxCell>
        <mxCell id="jobs" value="JOB LIFECYCLE PRIMITIVES&#xa;SKIP LOCKED claim + database clock&#xa;120s leases; monotonic fence; heartbeat&#xa;Cancel, bounded retry, stale-write refusal" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="920" y="780" width="350" height="145" as="geometry"/></mxCell>
        <mxCell id="parser" value="OFFLINE NORMALIZATION LIBRARY&#xa;PDF / Office / text / HTML / CSV&#xa;Typed locations; resource limits / warnings&#xa;Not wired to uploads; sandbox pending" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="50" y="780" width="520" height="145" as="geometry"/></mxCell>
        <mxCell id="worker" value="FUTURE WORKER PROCESS&#xa;No execution loop implemented&#xa;Will consume leased jobs and normalize&#xa;Will publish only verified generations" style="rounded=1;whiteSpace=wrap;html=0;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1400" y="780" width="320" height="145" as="geometry"/></mxCell>
        <mxCell id="n1" value="POST upload" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="request" target="perimeter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n2" value="Authorized" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="perimeter" target="snapshot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n3" value="Finalize original" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="snapshot" target="files"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n4" value="Snapshot reference + hash" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="snapshot" target="commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n5" value="Commit linked records" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="commit" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n6" value="Committed result" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="commit" target="response"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n7" value="Fenced transactions" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;exitX=1;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="jobs" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n8" value="Planned consumption" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;dashed=1;" edge="1" parent="1" source="worker" target="jobs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n9" value="Planned sandboxed parsing" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="worker" target="parser"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="1020"/><mxPoint x="310" y="1020"/></Array></mxGeometry></mxCell>
