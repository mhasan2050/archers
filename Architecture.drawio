        <mxCell id="art" value="PRIVATE ARTIFACT VOLUME | /data&#xa;Immutable originals, SHA-256 hashes&#xa;Generated tenant/document/version paths&#xa;File finalization before DB linkage" style="shape=cylinder3;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="100" y="450" width="440" height="160" as="geometry"/></mxCell>
        <mxCell id="migrate" value="ONE-SHOT MIGRATION SERVICE&#xa;Backend image / Alembic 0001 + 0002&#xa;PostgreSQL healthy before migration&#xa;Successful migration gates API startup" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="880" y="750" width="430" height="140" as="geometry"/></mxCell>
