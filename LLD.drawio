<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" compressed="false">
  <diagram id="lld-ingestion" name="LLD - Ingestion">
    <mxGraphModel dx="1500" dy="1750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ititle" value="LOW-LEVEL DESIGN | CONFIGURED INGESTION AND PUBLICATION" style="text;html=0;align=left;fontSize=25;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1400" height="45" as="geometry"/></mxCell>
        <mxCell id="isub" value="Read top to bottom. Blue = API; green = worker; purple = inference; gold = storage; red = exceptional outcome." style="text;html=0;align=left;fontSize=14;fontColor=#526477;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1400" height="35" as="geometry"/></mxCell>
        <mxCell id="upload" value="1. CONFIGURED CONNECTOR SNAPSHOT&#xa;Filesystem / S3 / Graph / Drive; stable revision&#xa;Alternative: authenticated curator/admin upload" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="140" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="validate" value="2. SHARED INGESTION VALIDATION&#xa;Scoped connector identity or curator/admin permission&#xa;Format signatures / limits / disk / archive safety" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="275" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="persist" value="3. STORE SOURCE AND ENQUEUE&#xa;Durable source PDF, then DB transaction&#xa;Version + job + source revision linkage" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="410" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="claim" value="4. WORKER CLAIMS JOB&#xa;SKIP LOCKED + fencing token&#xa;120 s lease / 20 s heartbeat" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="545" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="extract" value="5. CONFIGURED PARSER / CONDITIONAL OCR&#xa;PDF / DOCX / PPTX / XLSX / MD / text / HTML / CSV&#xa;Normalized blocks + truthful source locations" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="680" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="quality" value="6. Extraction quality&#xa;and provenance OK?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="505" y="805" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="chunk" value="7. STRUCTURE-AWARE CHUNKS&#xa;Tokenizer-aware limits and headings/table headers&#xa;PDF pages / slides / cells / lines / rows / blocks" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="970" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="embed" value="8. CONFIGURED DENSE + LOCAL SPARSE&#xa;Local default; approved external dense opt-in&#xa;Export/budget gates; no incompatible fallback" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="1105" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="index" value="9. STAGE AND VERIFY QDRANT GENERATION&#xa;Attempt-specific IDs; wait for writes&#xa;Verify expected point IDs/count and model metadata" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="1240" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="publish" value="10. ATOMIC POSTGRESQL ACTIVATION&#xa;Lock; verify lease, source revision, lifecycle&#xa;Switch active version/generation pointer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="1375" width="430" height="85" as="geometry"/></mxCell>
        <mxCell id="ready" value="READY / SEARCHABLE&#xa;Retire old generation; schedule safe cleanup" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#548235;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="1510" width="430" height="75" as="geometry"/></mxCell>
        <mxCell id="reject" value="REJECT / FAILED&#xa;Malformed, encrypted, oversized&#xa;Visible typed error; never searchable" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="275" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="review" value="REVIEW_REQUIRED&#xa;Affected pages and extraction report&#xa;Audited acceptance resumes chunking;&#xa;rejection leaves version unpublished" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="805" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="failure" value="FAILURE / CANCELLATION POLICY&#xa;&#xa;Permanent faults: fail or review.&#xa;Transient job faults: at most 3 attempts.&#xa;Stale leases cannot publish.&#xa;Failed update keeps old active version.&#xa;No silent page skipping." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="1105" width="300" height="220" as="geometry"/></mxCell>
        <mxCell id="istore" value="ARTIFACT VOLUME&#xa;source.pdf / document.md&#xa;docling.json / blocks.jsonl&#xa;quality.json / chunks.jsonl&#xa;Parser page provenance retained" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="1060" y="410" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="idb" value="POSTGRESQL&#xa;Documents / versions / source inventory&#xa;Jobs / leases / fencing tokens&#xa;Chunks / index generations&#xa;Active pointer + audit" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="1060" y="680" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="ivec" value="QDRANT&#xa;Dense + sparse vectors&#xa;Tenant filter payloads&#xa;Staged and active generations&#xa;Not the permission authority" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="1060" y="1200" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="imodel" value="LOCAL ASSETS / PROVIDER PROFILES&#xa;Pinned local weights and approved capability profiles&#xa;Missing assets / consent / budget = explicit error&#xa;See Product Configuration page" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1060" y="970" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="ifoot" value="Solid arrows = processing flow. Dashed arrows = reads/writes. Storage calls are representative, not exhaustive.&#xa;PostgreSQL and Qdrant have no shared transaction: query-time canonical checks exclude staged or stale generations. Proposed design; see LLD.md." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacing=15;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1635" width="1380" height="80" as="geometry"/></mxCell>
        <mxCell id="i1" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="upload" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i2" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="validate" target="persist"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i3" value="Durable job" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#548235;" edge="1" parent="1" source="persist" target="claim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i4" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="claim" target="extract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i5" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="extract" target="quality"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#548235;" edge="1" parent="1" source="quality" target="chunk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i7" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="chunk" target="embed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i8" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="embed" target="index"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i9" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="index" target="publish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i10" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="publish" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i11" value="Invalid" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b85450;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="validate" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i12" value="No" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b85450;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="quality" target="review"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i13" value="Approved" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="review" target="chunk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="1013"/></Array></mxGeometry></mxCell>
        <mxCell id="i14" value="Write source" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#b59a3e;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="persist" target="istore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i15" value="Write artifacts" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#b59a3e;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.8;" edge="1" parent="1" source="extract" target="istore"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="697"/><mxPoint x="980" y="530"/></Array></mxGeometry></mxCell>
        <mxCell id="i16" value="Lease / heartbeat" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#b59a3e;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="claim" target="idb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="588"/><mxPoint x="1010" y="710"/></Array></mxGeometry></mxCell>
        <mxCell id="i17" value="Upsert / verify" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#b59a3e;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="index" target="ivec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i18" value="Commit active pointer" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#b59a3e;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="publish" target="idb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="1418"/><mxPoint x="1460" y="755"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lld-query" name="LLD - Authorized Query Flow">
    <mxGraphModel dx="1500" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="qtitle" value="LOW-LEVEL DESIGN | AUTHORIZED LANGGRAPH QUERY" style="text;html=0;align=left;fontSize=25;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1400" height="45" as="geometry"/></mxCell>
        <mxCell id="qsub" value="Graph nodes run in the API process. Right-hand boxes are shared local services, not additional per-node containers." style="text;html=0;align=left;fontSize=14;fontColor=#526477;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1400" height="35" as="geometry"/></mxCell>
        <mxCell id="qstart" value="1. SUBMIT QUESTION&#xa;POST conversation runs; return 202 + run ID&#xa;Subscribe to durable SSE events" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="135" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="qauth" value="2. AUTHENTICATE + CHECK RBAC&#xa;Current role, enabled account, tenant, conversation owner&#xa;One run/conversation; save authorization revision" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="260" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="qresolve" value="3. RESOLVE FOLLOW-UP + ENCODE&#xa;Bounded history; local sparse; dense uses index profile&#xa;External dense needs requester consent and budget" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="390" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="qretrieve" value="4. HYBRID RETRIEVAL + RRF&#xa;Server-derived tenant filter on BOTH branches&#xa;40 dense + 40 sparse candidates; fuse up to 50 IDs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="520" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="qcheck" value="5. CANONICAL CHECK + EVIDENCE LOAD&#xa;PostgreSQL verifies ACL, active version/generation, deletion&#xa;Only then load permitted chunk text from artifacts" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="650" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="qrank" value="6. LOCAL RERANKING + CONTEXT BUDGET&#xa;Score up to 50 valid passages&#xa;Select up to 8 chunks; preserve IDs and locations" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="780" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="qenough" value="7. Sufficient&#xa;evidence?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="555" y="910" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="qretry" value="ONE REVISED SEARCH&#xa;If search attempt &lt; 2, revise question&#xa;Otherwise explicit abstention" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="910" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="qgen" value="8. GENERATE STRUCTURED ANSWER&#xa;Local OSS default; opt-in paid policy/budget gates&#xa;Answer + claims + server-assigned source IDs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="1070" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="qvalidate" value="9. VALIDATE CITATIONS AND CLAIM SUPPORT&#xa;Schema, IDs, format locations, quote/numeric checks&#xa;Local verifier assists; it is not proof of correctness" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="1200" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="qvalid" value="Valid and&#xa;supported?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="555" y="1330" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="qabstain" value="ABSTAIN&#xa;Insufficient / unsupported evidence&#xa;Do not invent an answer or citations&#xa;Persist and return explicit reason" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1330" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="qfinal" value="10. FINAL AUTHORIZATION + COMMIT&#xa;Recheck ACL revisions and active evidence&#xa;Persist answer + citation manifest + terminal event" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="1490" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="qdone" value="11. COMPLETED SSE EVENT&#xa;Validated answer + authenticated format locations&#xa;No draft answer tokens are displayed" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="1620" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="qdb" value="POSTGRESQL&#xa;Identity / roles / active versions&#xa;Run state / messages / event replay&#xa;LangGraph checkpoints / audit" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="1110" y="260" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="qvec" value="QDRANT&#xa;Dense + BM25 sparse branches&#xa;RRF fusion; return IDs, not evidence text&#xa;Never authoritative for authorization" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="1110" y="500" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="qinf" value="LOCAL INFERENCE SERVICE&#xa;Local dense default; sparse and reranking stay local&#xa;External dense via gateway (configuration page)&#xa;Pinned tokenizers; no silent truncation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1110" y="780" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="qllm" value="MODEL CAPABILITY ADAPTER&#xa;Local Ollama or explicitly approved paid profile&#xa;Verification/reranking stay local by default&#xa;No automatic model/vendor fallback" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1110" y="1070" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="qpolicy" value="EXPLICIT ERROR PATHS&#xa;&#xa;No permission: terminate / hide resource.&#xa;Dependency outage or deadline: typed error,&#xa;not an evidence-based abstention.&#xa;ACL/content changed: discard draft; restart&#xa;once within deadline or return conflict.&#xa;&#xa;150 s total budget; bounded queues.&#xa;No raw document content in logs.&#xa;LangSmith cloud tracing OFF." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="1090" y="1350" width="360" height="300" as="geometry"/></mxCell>
        <mxCell id="qfoot" value="Solid arrows = workflow. Dashed arrows = capability/service calls; responses omitted.&#xa;Canonical checks always consult PostgreSQL. Sources/history reauthorize. Local default, paid calls opt-in through policy/budget gates.&#xa;No arbitrary tools or unbounded loop. See Product Configuration page for provider/embedding policy and cost reservations." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;align=left;spacing=15;" vertex="1" parent="1"><mxGeometry x="40" y="1780" width="1410" height="115" as="geometry"/></mxCell>
        <mxCell id="q1" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="qstart" target="qauth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q2" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="qauth" target="qresolve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q3" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="qresolve" target="qretrieve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q4" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="qretrieve" target="qcheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q5" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="qcheck" target="qrank"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q6" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="qrank" target="qenough"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="qenough" target="qgen"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q8" value="No" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b59a3e;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="qenough" target="qretry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q9" value="One retry only" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b59a3e;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="qretry" target="qresolve"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="433"/></Array></mxGeometry></mxCell>
        <mxCell id="q10" value="Search limit reached" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b59a3e;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="qretry" target="qabstain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q11" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="qgen" target="qvalidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q12" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="qvalidate" target="qvalid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q13" value="No" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b59a3e;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="qvalid" target="qabstain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q14" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="qvalid" target="qfinal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q15" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="qfinal" target="qdone"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q16" value="Identity / run state" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#8064a2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="qauth" target="qdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q17" value="Filtered search" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#8064a2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="qretrieve" target="qvec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q18" value="Encode" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#8064a2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.2;" edge="1" parent="1" source="qresolve" target="qinf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="416"/><mxPoint x="990" y="802"/></Array></mxGeometry></mxCell>
        <mxCell id="q19" value="Rerank" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#8064a2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="qrank" target="qinf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q20" value="Generate" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#8064a2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="qgen" target="qllm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q21" value="Verify claims" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#8064a2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="qvalidate" target="qllm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="1243"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lld-nas-rbac" name="LLD - NAS Discovery and RBAC">
    <mxGraphModel dx="1600" dy="1550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ntitle" value="NAS AUTOMATION AND AUTHENTICATED ROLE-BASED ACCESS" style="text;html=0;align=left;fontSize=25;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1510" height="45" as="geometry"/></mxCell>
        <mxCell id="nsource" value="NAS SMB SHARE&#xa;Host mounts read-only using protected credentials&#xa;Only watcher receives read-only bind mount" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="490" height="90" as="geometry"/></mxCell>
        <mxCell id="nscan" value="WATCHER - POLL EVERY 30 s&#xa;Per-source lease; expected share sentinel UUID&#xa;Fresh host mount-health probe; complete traversal" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="490" height="90" as="geometry"/></mxCell>
        <mxCell id="nstable" value="NEW / CHANGED PATH&#xa;Stable observations spanning 60 s&#xa;Prefer atomic rename or ready size/hash manifest" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="490" height="90" as="geometry"/></mxCell>
        <mxCell id="nsnapshot" value="LOCAL IMMUTABLE SNAPSHOT&#xa;Stream copy + SHA-256 + pre/post stat + PDF checks&#xa;No marker: second hash after stability interval&#xa;Stability alone cannot prove producer completion" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="540" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="njob" value="PERSIST INVENTORY + VERSION + JOB&#xa;Deduplicate source/path/content; desired revision fence&#xa;Worker parses, chunks, embeds, stages, publishes&#xa;See PDF Ingestion page" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="nmissing" value="ABSENT PATH&#xa;3 complete healthy scans spanning at least 5 min&#xa;Final healthy not-found check + revision check" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="400" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="nwithdraw" value="CONFIRMED SOURCE DELETION&#xa;Withdraw in PostgreSQL; cancel stale jobs&#xa;Async local/vector cleanup; never delete NAS files" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="540" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="noutage" value="OUTAGE / PARTIAL SCAN / BULK DISAPPEARANCE&#xa;Freeze deletion; alert; preserve last active versions&#xa;Reset missing counters after outage&#xa;Over 20% missing or empty corpus: admin review" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="700" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="nidentity" value="LOCAL LOGIN&#xa;Argon2id password hashes; opaque sessions&#xa;CSRF + login throttling + no public registration" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1100" y="120" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="nrbac" value="SERVER-SIDE RBAC GATE&#xa;Current enabled account + role permission&#xa;Tenant boundary + conversation ownership&#xa;Unknown role/action denied" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1100" y="260" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="nreader" value="READER&#xa;Query / all active tenant PDFs&#xa;Own chats and feedback only" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1160" y="430" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="ncurator" value="CURATOR = READER PLUS&#xa;Upload / review / retry / cancel ingestion&#xa;Scan status and non-destructive rescan" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1100" y="580" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="nadmin" value="ADMIN = CURATOR PLUS&#xa;Users / roles / source configuration&#xa;Withdrawal / suppression / mass-deletion review" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1100" y="730" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="ndata" value="POSTGRESQL - AUTHORITATIVE STATE&#xa;Source scans / file hashes / desired revisions / leases / missing counters&#xa;Users / role enum / sessions / authorization revisions / audit&#xa;Documents / active generations / suppression / ingestion jobs" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="260" y="950" width="1070" height="150" as="geometry"/></mxCell>
        <mxCell id="nnotes" value="ACCESS POLICY&#xa;All enabled authenticated roles can read all active documents in their tenant. No NAS ACL mirroring.&#xa;Role changes / password resets / disable revoke sessions and pending runs. Protect the last enabled admin.&#xa;The scoped watcher service identity is not a human admin and cannot query chat or change roles.&#xa;&#xa;LIFECYCLE POLICY&#xa;Rename = new path plus old-path deletion confirmation. Same path + changed bytes = new version.&#xa;Daily content-hash reconciliation catches same-size/same-mtime changes. Pause does not mean deletion.&#xa;Manual suppression persists across scans; reappearance requires fresh ingestion before publication." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacing=20;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="1190" width="1460" height="285" as="geometry"/></mxCell>
        <mxCell id="ne1" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="nsource" target="nscan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne2" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="nscan" target="nstable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne3" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="nstable" target="nsnapshot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne4" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="nsnapshot" target="njob"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne5" value="Healthy complete scan only" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b59a3e;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="nscan" target="nmissing"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="305"/></Array></mxGeometry></mxCell>
        <mxCell id="ne6" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="nmissing" target="nwithdraw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne7" value="Any failed safety check" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b85450;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="nmissing" target="noutage"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="445"/><mxPoint x="1080" y="755"/></Array></mxGeometry></mxCell>
        <mxCell id="ne8" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="nidentity" target="nrbac"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne9" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="nrbac" target="nreader"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne10" value="Additional permissions" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nreader" target="ncurator"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne11" value="Additional permissions" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ncurator" target="nadmin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne12" value="Inventory / versions / jobs" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#b59a3e;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="njob" target="ndata"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne13" value="Accounts / role revisions / audit" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#b59a3e;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nadmin" target="ndata"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ne14" value="Withdraw before cleanup" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#b85450;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="nwithdraw" target="ndata"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="756" y="860"/><mxPoint x="902" y="860"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lld-product-config" name="LLD - Product Configuration">
    <mxGraphModel dx="1600" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="ctitle" value="CONFIGURATION, PROVIDER POLICY AND PRODUCTION RELEASE FLOW" style="text;html=0;align=left;fontSize=24;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="50" as="geometry"/></mxCell>
        <mxCell id="coperator" value="OPERATOR CONFIGURATION&#xa;Network mode / model profiles / price caps&#xa;Secret refs / endpoints / storage / TLS&#xa;Compose or Helm; same application images" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="430" height="120" as="geometry"/></mxCell>
        <mxCell id="cadmin" value="ADMIN SOURCE CONFIGURATION&#xa;Connector kind + scope + format subset&#xa;Independent generation/embedding export flags&#xa;Cannot override deployment deny" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="430" height="120" as="geometry"/></mxCell>
        <mxCell id="cvalidate" value="STRICT PREFLIGHT VALIDATION&#xa;Allowed connector/parser/provider capabilities&#xa;No arbitrary plugins/URLs/raw keys&#xa;Models / secrets / price / storage readiness" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="300" y="320" width="570" height="120" as="geometry"/></mxCell>
        <mxCell id="crun" value="PIN RUN / JOB PROFILE AND REVISIONS&#xa;Query consent + source/document export approval&#xa;Same encoder as index; sparse/rerank local&#xa;Remote source connection is NOT model consent" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="570" height="120" as="geometry"/></mxCell>
        <mxCell id="croute" value="Selected capability&#xa;local or external?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="445" y="700" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="clocal" value="LOCAL OSS DEFAULT&#xa;Pinned license-reviewed preloaded weights&#xa;Memory/concurrency/token limits&#xa;No runtime downloads" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="430" height="120" as="geometry"/></mxCell>
        <mxCell id="cbudget" value="ATOMIC COST / EXPORT GATE&#xa;Approved profile and destination&#xa;Reserve worst-case call cost in PostgreSQL&#xa;Include pending calls and bounded retries" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="900" y="700" width="600" height="120" as="geometry"/></mxCell>
        <mxCell id="cpaid" value="PAID CAPABILITY ADAPTER&#xa;OpenAI / Azure / Anthropic / Gemini / compatible&#xa;Generation and embeddings independently selected&#xa;Capability tests; Anthropic not assumed to embed" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="900" y="900" width="600" height="120" as="geometry"/></mxCell>
        <mxCell id="cfinish" value="VALIDATE RESULT + RECONCILE USAGE&#xa;Preserve citations / export/auth revisions; commit final result&#xa;Unknown billing retains safe reservation; no automatic billed replay&#xa;Profile/index switch requires staged reindex and atomic routing promotion" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="300" y="1100" width="1200" height="120" as="geometry"/></mxCell>
        <mxCell id="cblocked" value="EXPLICIT ERRORS&#xa;Unapproved export / missing consent: 403&#xa;Unsupported profile: 422&#xa;Budget/capacity limit: 429&#xa;Dependency/deadline: 503/504&#xa;No silent paid/vendor/encoder fallback" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1100" y="320" width="400" height="180" as="geometry"/></mxCell>
        <mxCell id="cfoot" value="RELEASE GATES: signed/pinned images, licenses/SBOM, populated N-1 migrations, backup/restore, RBAC/privacy and format/connector matrices.&#xa;PERFORMANCE: small/medium/large reproducible workloads; measure quality, p95, throughput, RAM/VRAM, freshness and cost. No unmeasured SLA.&#xa;K8s uses shared RWX/object artifacts plus DB-backed leases/budget limits across replicas; Compose single host is not HA." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="1440" height="120" as="geometry"/></mxCell>
        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="coperator" target="cvalidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="cadmin" target="cvalidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="cvalidate" target="crun"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#8064a2;" edge="1" parent="1" source="crun" target="croute"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce5" value="Local" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#8064a2;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="croute" target="clocal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="275" y="760"/></Array></mxGeometry></mxCell>
        <mxCell id="ce6" value="External opt-in" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b85450;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="croute" target="cbudget"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce7" value="Reserved and permitted" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b85450;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cbudget" target="cpaid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce8" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="clocal" target="cfinish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce9" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="cpaid" target="cfinish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce10" value="Failed gate" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#b85450;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cbudget" target="cblocked"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
