<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="acceptance" name="1 - Manual Upload (Implemented)">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1550">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="MANUAL UPLOAD | IMPLEMENTED ACCEPTANCE" style="text;html=0;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="legend" value="Green: implemented. Red: explicit rejection/error. Yellow: asynchronous acceptance boundary. Upload API and worker exist; upload UI is pending." style="text;html=0;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1400" height="50" as="geometry"/></mxCell>
        <mxCell id="start" value="Curator/admin submits file + title&#xa;Session cookie, CSRF, Origin, idempotency key&#xa;Replacement also supplies If-Match revision" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="160" width="510" height="100" as="geometry"/></mxCell>
        <mxCell id="auth" value="Trusted Host/Origin, current session,&#xa;tenant, ingestion role and CSRF valid?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="360" y="310" width="450" height="130" as="geometry"/></mxCell>
        <mxCell id="bytes" value="Bound multipart bytes; require file + title only&#xa;Check allowed extension and byte signature&#xa;Hash, fsync and atomically finalize private snapshot" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="500" width="510" height="110" as="geometry"/></mxCell>
        <mxCell id="tx" value="Begin PostgreSQL acceptance transaction&#xa;Serialize tenant and recheck current authorization" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="670" width="510" height="90" as="geometry"/></mxCell>
        <mxCell id="replay" value="Matching committed idempotency result?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="360" y="810" width="450" height="130" as="geometry"/></mxCell>
        <mxCell id="checks" value="Validate idempotency conflict / desired revision&#xa;Manual-only replacement and queue capacity&#xa;Reject conflict or overflow explicitly" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="1000" width="510" height="100" as="geometry"/></mxCell>
        <mxCell id="commit" value="Commit document + version + job + audit + replay result&#xa;Replacement cancels superseded jobs&#xa;Preserve any previously active version" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="1160" width="510" height="100" as="geometry"/></mxCell>
        <mxCell id="accepted" value="HTTP 202 with document/version/job IDs&#xa;Document PENDING; version RECEIVED; job PENDING&#xa;Worker parses and indexes asynchronously after acceptance" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="1340" width="510" height="110" as="geometry"/></mxCell>
        <mxCell id="reject" value="Explicit failure response&#xa;401/403 security rejection&#xa;400/413/415 invalid or oversized upload&#xa;409 conflict; 429 queue backpressure&#xa;No new accepted job on rejection" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1020" y="380" width="400" height="170" as="geometry"/></mxCell>
        <mxCell id="existing" value="Discard duplicate snapshot&#xa;Return stored acceptance IDs&#xa;No extra version/job or queue slot" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1020" y="820" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="uncertain" value="Uncertain database commit failure&#xa;Report error; retain snapshot conservatively&#xa;Orphan reconciliation is planned" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1020" y="1160" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="start" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="auth" target="bytes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="No" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="auth" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="Valid snapshot" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="bytes" target="tx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="Invalid input" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="bytes" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="tx" target="replay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="replay" target="existing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" value="No" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="replay" target="checks"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9" value="Checks pass" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="checks" target="commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10" value="Conflict / full queue" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;exitX=0;exitY=0.5;entryX=1;entryY=0.8;" edge="1" parent="1" source="checks" target="reject"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="1050"/><mxPoint x="200" y="150"/><mxPoint x="1460" y="150"/><mxPoint x="1460" y="515"/></Array></mxGeometry></mxCell>
        <mxCell id="a11" value="Commit succeeds" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="commit" target="accepted"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a12" value="Commit uncertain" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="commit" target="uncertain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a13" value="Authorization changed" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;" edge="1" parent="1" source="tx" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
