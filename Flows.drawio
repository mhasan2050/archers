  </diagram>
  <diagram id="query" name="3 - RAG Query (Planned)">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AUTHENTICATED RAG QUERY | PLANNED LANGGRAPH FLOW" style="text;html=0;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1600" height="50" as="geometry"/></mxCell>
        <mxCell id="legend" value="All dashed paths are planned. Local OSS models by default; paid generation and dense embeddings require separate explicit approvals." style="text;html=0;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1600" height="50" as="geometry"/></mxCell>
        <mxCell id="question" value="Authenticated user submits question / follow-up&#xa;Owned conversation; one active run per conversation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="160" width="560" height="90" as="geometry"/></mxCell>
        <mxCell id="authorize" value="Recheck session, tenant, current RBAC and ownership&#xa;Validate model/export policy and reserve budget&#xa;Create durable run and authorized LangGraph state" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="310" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="resolve" value="Resolve follow-up using permitted conversation context&#xa;Previous assistant replies are not document evidence&#xa;Configured dense encoding; local sparse encoding" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="480" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="search" value="Tenant-filtered Qdrant dense + sparse search / fusion&#xa;Check canonical active versions in PostgreSQL&#xa;Reject staged, retired or withdrawn evidence" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="640" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="evidence" value="Load permitted evidence; local rerank and selection&#xa;Preserve document IDs and format-specific locations&#xa;Count actual prompt/history/evidence tokens" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="800" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="enough" value="Sufficient supported evidence?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="960" width="460" height="130" as="geometry"/></mxCell>
        <mxCell id="generate" value="Generate grounded answer with configured model&#xa;Preloaded local OSS by default&#xa;No arbitrary tools, web access or autonomous loop" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="1150" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="validate" value="Validate claims and citations against evidence&#xa;Unsupported claims produce explicit abstention&#xa;Do not stream unvalidated draft answer tokens" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="1310" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="final" value="Final authorization and content/lifecycle check&#xa;Commit validated answer OR explicit abstention&#xa;Persist evidence manifest, revisions and usage" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="1500" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="complete" value="Emit durable completed SSE event&#xa;User receives validated answer + citations or abstention&#xa;Reconnect replays events, never repeats generation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="1670" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="errors" value="Distinct terminal error / cancellation outcomes&#xa;Unauthorized or revoked: no protected content&#xa;Unavailable model/store: explicit dependency error&#xa;Budget/policy denied: no external call&#xa;Never disguise an infrastructure failure as abstention" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="310" width="500" height="180" as="geometry"/></mxCell>
        <mxCell id="providers" value="Optional external model gateway&#xa;Generation and embeddings independently approved&#xa;Recheck source export, endpoint, secrets and budget&#xa;LangSmith hosted tracing separately approved; off by default" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="640" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="retry" value="Second bounded search still available?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1130" y="960" width="460" height="130" as="geometry"/></mxCell>
        <mxCell id="abstain" value="Explicit abstention&#xa;Insufficient or unsupported document evidence&#xa;No invented answer or fabricated citations" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="1310" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="notes" value="LangChain: typed model/vector integrations. LangGraph: bounded query state and control flow with authorized PostgreSQL checkpoints.&#xa;The current application has no query runtime or loaded models; readiness intentionally returns 503." style="text;html=0;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1810" width="1600" height="60" as="geometry"/></mxCell>
        <mxCell id="q1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="question" target="authorize"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q2" value="Approved" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="authorize" target="resolve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q3" value="Failure at any stage" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="authorize" target="errors"><mxGeometry relative="1" as="geometry"/></mxCell>
