  </diagram>
  <diagram id="ingestion" name="2 - Automatic Ingestion (Planned)">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AUTOMATIC SOURCE INGESTION | PLANNED WORKFLOW" style="text;html=0;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1600" height="50" as="geometry"/></mxCell>
        <mxCell id="legend" value="Target flow. Watcher, parsing, chunking, local embeddings and verified activation are implemented. OCR, withdrawals, review-resolution and paid embeddings remain planned." style="text;html=0;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1600" height="50" as="geometry"/></mxCell>
        <mxCell id="poll" value="Fenced source scanner polls approved connector&#xa;NAS/filesystem read-only; cloud adapters separately approved" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="560" height="90" as="geometry"/></mxCell>
        <mxCell id="health" value="Fresh source identity/health and&#xa;complete observations available?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="290" width="460" height="130" as="geometry"/></mxCell>
        <mxCell id="stable" value="Observe allowed new/changed files&#xa;NAS: three unchanged observations spanning 60 seconds&#xa;Ready manifest preferred; hash reconciliation catches changes" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="480" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="snapshot" value="Fenced snapshot: copy + hash + pre/post stat checks&#xa;Changed copy returns to stability observation&#xa;No manifest: second source hash before publication" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="enqueue" value="Finalize immutable original; commit version/job&#xa;Recheck source, desired revision, suppression and fence&#xa;Deduplicate; respect queue backpressure" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="820" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="worker" value="Worker claims durable PostgreSQL job&#xa;SKIP LOCKED; lease, heartbeat and fencing&#xa;Check cancellation and desired revision at every stage" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="980" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="parse" value="VALIDATING -> EXTRACTING -> QUALITY_CHECK&#xa;Isolated allowlisted parser and local OCR where needed&#xa;Normalized blocks + Markdown + authoritative locations" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="1140" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="quality" value="Quality and provenance sufficient?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="1290" width="460" height="130" as="geometry"/></mxCell>
        <mxCell id="index" value="CHUNKING -> EMBEDDING -> INDEXING -> VERIFYING&#xa;Token-aware chunks; local dense/sparse encoding by default&#xa;Stage Qdrant generation; verify IDs/count/fingerprint" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="330" y="1480" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="publish" value="Lock and recheck lifecycle, revision, lease and cancellation&#xa;Activate verified generation pointer in PostgreSQL -> READY&#xa;Retire old generation asynchronously; no shared SQL/vector transaction" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="1650" width="620" height="110" as="geometry"/></mxCell>
        <mxCell id="pause" value="Pause ingestion/deletion reconciliation&#xa;Alert and show stale-corpus warning&#xa;Keep existing active corpus&#xa;Outage/permission error never proves deletion" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="290" width="500" height="140" as="geometry"/></mxCell>
        <mxCell id="absence" value="Missing-file reconciliation (NAS default)&#xa;Three healthy absences over at least five minutes&#xa;Final healthy not-found; freeze bulk loss for review&#xa;Recheck revisions, withdraw and cancel publication&#xa;Never delete originals from the source" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="480" width="500" height="180" as="geometry"/></mxCell>
        <mxCell id="failure" value="Worker error / cancellation / stale owner&#xa;Transient fault: at most three attempts&#xa;Permanent fault: FAILED; cancellation: CANCELLED&#xa;Lost fence/revision: do not publish&#xa;Failed replacement preserves old active version" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="980" width="500" height="180" as="geometry"/></mxCell>
        <mxCell id="review" value="REVIEW_REQUIRED&#xa;Audited curator/admin resolution&#xa;No silently skipped bad pages or invented provenance&#xa;Approved corrections re-enter quality validation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="1290" width="500" height="140" as="geometry"/></mxCell>
        <mxCell id="policy" value="Optional paid embeddings only through approved gateway&#xa;Source export approval + pinned profile + budget reservation&#xa;Never silently fall back from local to paid" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="1490" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="i1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="poll" target="health"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="health" target="stable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i3" value="No" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="health" target="pause"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i4" value="Stable candidate" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="stable" target="snapshot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i5" value="Missing observations" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="stable" target="absence"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i6" value="Verified snapshot" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="snapshot" target="enqueue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i7" value="Changed during copy" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="snapshot" target="stable"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="705"/><mxPoint x="210" y="535"/></Array></mxGeometry></mxCell>
        <mxCell id="i8" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="enqueue" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i9" value="Current owner" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="worker" target="parse"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i10" value="At any worker stage" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="worker" target="failure"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i11" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="parse" target="quality"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i12" value="Yes" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="quality" target="index"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i13" value="No" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="quality" target="review"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i14" value="Verified and eligible" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="index" target="publish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i15" value="Policy gate for external encoding" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;" edge="1" parent="1" source="policy" target="index"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i16" value="Approved retry when eligible" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="review" target="parse"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="1810"/><mxPoint x="160" y="1810"/><mxPoint x="160" y="1190"/></Array></mxGeometry></mxCell>
      </root>
