<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" compressed="false">
  <diagram id="hld-overview" name="HLD - Local Default">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="SELF-HOSTED KNOWLEDGE ASSISTANT | LOCAL DEFAULT PATH" style="text;html=0;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1510" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Default local model / mounted PDF specialization. Configurable sources, formats and paid models: see Product Deployment page." style="text;html=0;align=left;fontSize=15;fontColor=#526477;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1510" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="boundary" value="DOCKER COMPOSE - INTERNAL RUNTIME NETWORK - NO EXTERNAL EGRESS" style="swimlane;html=0;startSize=40;horizontal=1;rounded=1;fillColor=#f5f8fc;swimlaneFillColor=#f5f8fc;strokeColor=#8ca4bf;dashed=1;fontSize=15;fontStyle=1;align=left;spacingLeft=20;container=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="235" width="1510" height="675" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="COMPANY USER / ADMIN&#xa;Browser: chat, uploads, PDF viewer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontSize=16;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="135" width="320" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="web" value="web :8080&#xa;React UI + reverse proxy&#xa;Only host port: 127.0.0.1:8080" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="330" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="api :8000&#xa;FastAPI + embedded LangGraph&#xa;Local login + RBAC + source access&#xa;LangChain adapters" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="320" width="400" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="worker - no public port&#xa;Durable ingestion + maintenance&#xa;Docling / local OCR / chunking" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1110" y="330" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="inference" value="inference :8081&#xa;Local dense + sparse encoders&#xa;Cross-encoder reranking&#xa;Preloaded model cache" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="560" width="320" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="ollama" value="ollama :11434&#xa;Local generation + claim verification&#xa;Preloaded weights; no cloud fallback" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="560" width="400" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="postgres" value="postgres :5432&#xa;Users / roles / sessions / source inventory&#xa;Versions / leased jobs / audit&#xa;Runs / messages / checkpoints" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="1110" y="550" width="360" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="qdrant" value="qdrant :6333&#xa;Dense + sparse vectors / RRF&#xa;Filtered candidate IDs&#xa;Rebuildable index, not ACL authority" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="90" y="755" width="320" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="artifacts" value="SHARED ARTIFACT VOLUME&#xa;Original PDFs + Markdown + JSON&#xa;Blocks / page provenance / chunks&#xa;Served only through authorized API" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="530" y="755" width="400" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="ops" value="LOCAL OPERATIONS&#xa;Redacted logs / metrics / evaluations&#xa;One-shot migrate + admin bootstrap&#xa;Persistent DB, vector, model volumes" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1110" y="755" width="360" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Same-origin HTTP / SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#366092;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="web"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="REST + progress events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#366092;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="web" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Embed / rerank" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#8064a2;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=0.7;entryY=0;" edge="1" parent="1" source="api" target="inference"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Generate / verify" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#8064a2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="ollama"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Authorize / persist / enqueue jobs" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.3;" edge="1" parent="1" source="api" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Claim / heartbeat / publish" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Filtered hybrid retrieval" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="qdrant"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="350"/><mxPoint x="60" y="818"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="PDF upload / authorized evidence reads" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;entryX=1;entryY=0.4;" edge="1" parent="1" source="api" target="artifacts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="428"/><mxPoint x="990" y="805"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="Local embedding batches" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.2;" edge="1" parent="1" source="worker" target="inference"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="495"/><mxPoint x="450" y="495"/><mxPoint x="450" y="583"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="Read PDF / write derivatives" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.9;entryY=1;" edge="1" parent="1" source="worker" target="artifacts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1520" y="380"/><mxPoint x="1520" y="895"/><mxPoint x="890" y="895"/></Array></mxGeometry></mxCell>
        <mxCell id="e11" value="Stage / verify index generation" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.85;" edge="1" parent="1" source="worker" target="qdrant"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="310"/><mxPoint x="50" y="310"/><mxPoint x="50" y="861"/></Array></mxGeometry></mxCell>
        <mxCell id="nas" value="NAS SMB SHARE (HOST-MOUNTED)&#xa;Read-only service account; host-held credentials" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="135" width="440" height="75" as="geometry"/></mxCell>
        <mxCell id="watcher" value="watcher - poll 30 s; stable snapshots&#xa;Source inventory + lifecycle reconciliation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="530" y="277" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="naswatch" value="Read-only bind mount" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#548235;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="nas" target="watcher"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="173"/></Array></mxGeometry></mxCell>
        <mxCell id="watchdb" value="Inventory + durable jobs" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#548235;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;entryX=1;entryY=0.2;" edge="1" parent="1" source="watcher" target="postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="266"/><mxPoint x="1500" y="577"/></Array></mxGeometry></mxCell>
        <mxCell id="watchfiles" value="Immutable local PDF snapshot" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#548235;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="watcher" target="artifacts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="292"/><mxPoint x="1060" y="855"/></Array></mxGeometry></mxCell>
        <mxCell id="legend" value="RBAC: reader = read/chat; curator = ingestion/review; admin = accounts/roles/sources. All authenticated roles read all active documents.&#xa;BLUE: requests   GREEN DASHED: background work   PURPLE: local models   GOLD: stores. Responses omitted; see LLD for NAS safety." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;fontColor=#526477;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="1510" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="smith" value="LANGSMITH: cloud tracing OFF. Self-hosting requires Enterprise licensing and deployment review; not a baseline container.&#xa;Models/images are prepared before offline runtime. All components are proposed, not implemented. See HLD.md and LLD.md." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="995" width="1510" height="75" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hld-product" name="HLD - Product Deployment">
    <mxGraphModel dx="1700" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="ptitle" value="CONFIGURABLE RAG PRODUCT | ONE COMPANY PER INSTALLATION" style="text;html=0;align=left;fontSize=26;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="50" as="geometry"/></mxCell>
        <mxCell id="psources" value="CONFIGURED SOURCES&#xa;Filesystem / SMB / NFS / uploads&#xa;S3 / SharePoint / OneDrive / Google Drive" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="pconnector" value="CONNECTOR ADAPTERS&#xa;Approved scope / secret refs / health / cursors&#xa;Immutable snapshots; safe deletion proof" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="pparser" value="PARSER ADAPTERS&#xa;PDF / DOCX / PPTX / XLSX&#xa;Markdown / text / HTML / CSV&#xa;Local OCR; truthful format locations" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="440" height="130" as="geometry"/></mxCell>
        <mxCell id="pindex" value="SHARED INGESTION / INDEXING&#xa;Normalize / chunk / encode / verify&#xa;Fenced jobs; atomic generation promotion" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="puser" value="AUTHENTICATED USERS&#xa;Reader / curator / admin&#xa;All active corpus visible; chats owner-only" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="papi" value="FASTAPI + LANGGRAPH + LANGCHAIN&#xa;RBAC / retrieval / local rerank / citations&#xa;Bounded query workflow; validated final SSE" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="620" y="310" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="pgate" value="MODEL CAPABILITY GATEWAY&#xa;Independent generation and dense embeddings&#xa;Policy + source approval + requester consent&#xa;Atomic budgets / endpoint gates / profile pins" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="620" y="500" width="460" height="130" as="geometry"/></mxCell>
        <mxCell id="plocal" value="DEFAULT LOCAL OSS MODELS&#xa;Ollama generation; local embeddings&#xa;Sparse encoding / reranking stay local&#xa;Preloaded, license-reviewed weights" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="620" y="710" width="460" height="130" as="geometry"/></mxCell>
        <mxCell id="ppaid" value="EXPLICIT OPT-IN PAID PROVIDERS&#xa;OpenAI / Azure / Anthropic / Gemini&#xa;Approved OpenAI-compatible endpoints&#xa;Capabilities vary; no automatic paid fallback" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1220" y="500" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="pdeploy" value="VERSIONED RELEASE&#xa;Compose bundle + Kubernetes Helm chart&#xa;Same signed images / config / migrations&#xa;TLS / secrets / SBOM / licenses / runbooks" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1220" y="120" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="pstorage" value="PERSISTENT, SHARED AUTHORITY&#xa;PostgreSQL: users / jobs / source cursors / policies / budget ledger&#xa;Qdrant: fingerprinted dense + sparse index; not access authority&#xa;Compose volume OR K8s shared RWX/object artifacts; immutable snapshots" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="140" y="940" width="1410" height="140" as="geometry"/></mxCell>
        <mxCell id="pnotes" value="NETWORK: airgap / connected sources / external models. Connector downloads never grant LLM export consent. Tracing stays OFF.&#xa;COST: shared worst-case reservations, finite caps, pricing revisions, billing reconciliation. Local hardware/operations are not free.&#xa;PERFORMANCE: incremental reads, batching, warm models, scoped caches, backpressure; publish quality-preserving benchmarks, not unmeasured claims.&#xa;PRODUCTION: tested install, N-1 upgrade, backup/restore and certified topologies. Kubernetes alone is not HA. All components remain design scope." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="1610" height="130" as="geometry"/></mxCell>
        <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="psources" target="pconnector"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="pconnector" target="pparser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#548235;" edge="1" parent="1" source="pparser" target="pindex"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe4" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#366092;" edge="1" parent="1" source="puser" target="papi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe5" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#8064a2;" edge="1" parent="1" source="papi" target="pgate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe6" value="Dense encoding" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#8064a2;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.7;" edge="1" parent="1" source="pindex" target="pgate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="743"/><mxPoint x="550" y="591"/></Array></mxGeometry></mxCell>
        <mxCell id="pe7" value="Default" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#8064a2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pgate" target="plocal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe8" value="Approved only" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#b85450;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pgate" target="ppaid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe9" value="Verified generations" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#b59a3e;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pindex" target="pstorage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe10" value="Retrieval / runs / budgets" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#b59a3e;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="papi" target="pstorage"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1680" y="398"/><mxPoint x="1680" y="1010"/></Array></mxGeometry></mxCell>
        <mxCell id="pe11" value="Storage / upgrade / restore" style="edgeStyle=orthogonalEdgeStyle;html=0;dashed=1;endArrow=block;strokeColor=#999999;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.6;entryX=0.9;entryY=0;" edge="1" parent="1" source="pdeploy" target="pstorage"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="198"/><mxPoint x="1160" y="880"/><mxPoint x="1409" y="880"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
